[General]
MenuKey=119
UILanguage=-1

; Optional. Only used for Chinese/Japanese/Korean when the game itself is not
; running in that language (the overlay draws that text).
[Overlay]
; Text size, percent (40-300). Raise/lower if the CJK text looks too small/large.
CjkTextScalePercent=100
; Vertical nudge in thousandths of the screen height (-100..100). Positive = down.
CjkTextYOffsetPermille=0
; Only used when the game runs in HDR: brightness of white overlay text, in nits
; (80-1000). Raise/lower if CJK text looks dimmer/brighter than the game's own text.
CjkHdrPaperWhiteNits=230
; 1 = write HuntingCompanion.overlay.log next to the ASI (for troubleshooting).
OverlayLog=0

; Hotkeys and weapon/ammo icons (all also changeable on the in-game Settings page).
; Key numbers are Windows virtual-key codes: 219 = [   221 = ]
; These belong in the [General] section above.
; FilterKey=219          ; toggles the "craftable now" filter
; WeaponIconsKey=221     ; shows / hides the weapon and ammo icons
; ShowWeaponIcons=1      ; 1 = show, 0 = hide
; MenuFont=0             ; menu font, 0-4 (same order as the Settings row)
; UseGameFontsOnly=0     ; 1 = never use the overlay, draw all text with the game's fonts
