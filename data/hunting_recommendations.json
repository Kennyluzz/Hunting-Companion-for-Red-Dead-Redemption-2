{
  "schemaVersion": 1,
  "description": "Weapon and ammunition guidance for every huntable species in the 162-entry standard Story Mode Animal Compendium, taken only from the game's own Compendium text.",
  "source": {
    "title": "Red Dead Redemption 2 in-game Animal Compendium (Rockstar's text)",
    "url": "https://wafflecomposite.github.io/rdr_compendium/animals.html",
    "method": "Each species uses the Compendium's own 'Use a ... for a clean kill.' line, quoted in sourceRule; compendiumEntries lists the Compendium animals it covers, which all give the same advice. 'a rifle' is shown as Rifle and 'a long scope rifle' as Sniper rifle. Domestic and working animals, which the Compendium gives no clean-kill line, are listed in noRecommendationEntries. Legendary animals share models with the regular ones, so the regular animal's advice is shown for them.",
    "numbering": "compendiumNumbers follow the standard Story Mode Animal Compendium order (1-162)."
  },
  "weaponTextures": {
    "Bow": "weapon_bow",
    "Varmint Rifle": "weapon_rifle_varmint",
    "Repeater": "weapon_repeater_lancaster",
    "Rifle": "weapon_rifle_springfield",
    "Sniper rifle": "weapon_sniperrifle_carcano"
  },
  "ammoTextures": {
    "Small Game Arrows": "ammo_arrow_small_game",
    "Improved Arrows": "ammo_arrow_improved",
    "Poisoned Arrows": "ammo_arrow_poison"
  },
